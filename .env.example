# =============================================================================
# CẤU HÌNH MÔI TRƯỜNG DỰ ÁN HỎA DIỆM CÁC (BACKEND SPRING BOOT)
# =============================================================================

# Cổng Server Backend
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# -----------------------------------------------------------------------------
# CẤU HÌNH DATABASE: CHỌN 1 TRONG 2 CÁCH DƯỚI ĐÂY
# -----------------------------------------------------------------------------

# CÁCH 1: KẾT NỐI CLOUD MYSQL TRÊN AIVEN (KHUYẾN NGHỊ DÙNG AIVEN)
# Copy "Service URI" từ Aiven Console (Overview -> Service URI) rồi dán vào DB_URL:
# Ví dụ: mysql://avnadmin:AVNS_xxxx@mysql-xxxx-xxxx.a.aivencloud.com:12345/defaultdb?ssl-mode=REQUIRED
# Định dạng JDBC tương ứng:
# DB_URL=jdbc:mysql://mysql-xxxx-xxxx.a.aivencloud.com:12345/defaultdb?sslMode=REQUIRED&serverTimezone=UTC
# DB_USERNAME=avnadmin
# DB_PASSWORD=your_aiven_password_here

# CÁCH 2: KẾT NỐI QUA CÁC THÔNG SỐ TỪNG PHẦN (CHO CẢ AIVEN HOẶC LOCAL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=hoadiemcat_db
DB_USERNAME=root
DB_PASSWORD=root
DB_SSL=false
DB_SSL_MODE=PREFERRED

# Chế độ khởi tạo schema Hibernate (update / validate / none)
HIBERNATE_DDL_AUTO=update
SHOW_SQL=true

# -----------------------------------------------------------------------------
# CẤU HÌNH BẢO MẬT JWT (HMAC-SHA256 256-bit Hex Key)
# -----------------------------------------------------------------------------
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION=86400000

# -----------------------------------------------------------------------------
# CẤU HÌNH CORS (CLIENT FRONTEND)
# -----------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
